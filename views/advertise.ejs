<%- include("partials/header", {
  active: "advertise",
  bodyId: "page-advertise",
  pageTitle: "Advertise a Vacancy | HEYA Talent Solutions",
  pageDescription: "Submit a vacancy request to HEYA Talent Solutions for job advertising, candidate sourcing, and recruitment support."
}) %>

<main id="content">
  <section class="page-hero section--dark">
    <canvas id="advertiseWireframeCanvas" class="wireframe-canvas" aria-hidden="true" hidden></canvas>
    <figure class="page-hero__cover" aria-hidden="true">
      <img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1800&q=70" alt="" loading="eager" decoding="async" />
    </figure>
    <div class="container page-hero__inner">
      <p class="eyebrow eyebrow--gold">Employer Request</p>
      <h1>Advertise a Vacancy</h1>
      <p>Submit your hiring requirement and HEYA Talent Solutions will help you promote your vacancy or connect you with recruitment support.</p>
    </div>
  </section>

  <section class="section">
    <div class="container form-page">
      <div>
        <p class="eyebrow">Vacancy Details</p>
        <h2>Tell us what your company needs</h2>
        <p>Use this form for job advertising, candidate sourcing, screening, workforce mobilization, labour hire support, or recruitment partnership enquiries. Do not submit candidate resumes here.</p>
      </div>

      <form id="advertise-form" class="form" method="post" action="/api/careers/employer-submissions" novalidate>
        <input type="hidden" name="packageInterest" id="packageInterest" />
        <div class="form-grid">
          <label>
            <span>Full Name</span>
            <input type="text" name="fullName" autocomplete="name" required />
          </label>
          <label>
            <span>Company Name</span>
            <input type="text" name="companyName" autocomplete="organization" required />
          </label>
          <label>
            <span>Job Title / Position Needed</span>
            <input type="text" name="jobTitle" required />
          </label>
          <label>
            <span>Industry</span>
            <select name="industry" required>
              <option value="">Select an industry</option>
              <option>Mining &amp; Resources</option>
              <option>Oil &amp; Gas</option>
              <option>Construction &amp; Infrastructure</option>
              <option>Logistics &amp; Transport</option>
              <option>Hospitality &amp; Catering</option>
              <option>Security Services</option>
              <option>Government &amp; Public Sector</option>
              <option>Retail &amp; Commercial</option>
              <option>Agriculture &amp; Agribusiness</option>
              <option>Health &amp; Community Services</option>
              <option>Telecommunications</option>
              <option>Professional Services</option>
              <option>Other</option>
            </select>
          </label>
          <label>
            <span>Number of Vacancies</span>
            <input type="number" name="numberOfVacancies" min="1" step="1" placeholder="Example: 1" />
          </label>
          <label>
            <span>Work Location</span>
            <input type="text" name="location" required />
          </label>
          <label>
            <span>Employment Type</span>
            <select name="employmentType" required>
              <option value="">Select employment type</option>
              <option>Full-time</option>
              <option>Contract</option>
              <option>FIFO</option>
              <option>Project-based</option>
              <option>Temporary</option>
              <option>Other</option>
            </select>
          </label>
          <label>
            <span>Phone</span>
            <input type="tel" name="phone" autocomplete="tel" required />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>
          <label>
            <span>Salary / Budget Range</span>
            <input type="text" name="salaryDisplay" placeholder="Optional" />
          </label>
          <label>
            <span>Company Career Site URL <em style="font-weight:400;font-size:0.85em">(optional)</em></span>
            <input type="url" name="careerSiteUrl" placeholder="https://yourcompany.com/careers — leave blank if you prefer HEYA to receive applications directly" />
          </label>
        </div>
        <label>
          <span>Message / Additional Requirements</span>
          <textarea name="message" rows="7" placeholder="Tell us about the role, required experience, location, start date, and any workforce requirements."></textarea>
        </label>
        <button class="cta" type="submit">
          <span class="span" data-submit-label>Submit Vacancy Enquiry</span>
          <span class="second" aria-hidden="true">
            <svg width="50px" height="20px" viewBox="0 0 66 43" xmlns="http://www.w3.org/2000/svg">
              <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                <path class="one" d="M40.1543933,3.89485454 L43.9763149,0.139296592 C44.1708311,-0.0518420739 44.4826329,-0.0518571125 44.6771675,0.139262789 L65.6916134,20.7848311 C66.0855801,21.1718824 66.0911863,21.8050225 65.704135,22.1989893 C65.7000188,22.2031791 65.6958657,22.2073326 65.6916762,22.2114492 L44.677098,42.8607841 C44.4825957,43.0519059 44.1708242,43.0519358 43.9762853,42.8608513 L40.1545186,39.1069479 C39.9575152,38.9134427 39.9546793,38.5968729 40.1481845,38.3998695 C40.1502893,38.3977268 40.1524132,38.395603 40.1545562,38.3934985 L56.9937789,21.8567812 C57.1908028,21.6632968 57.193672,21.3467273 57.0001876,21.1497035 C56.9980647,21.1475418 56.9959223,21.1453995 56.9937605,21.1432767 L40.1545208,4.60825197 C39.9574869,4.41477773 39.9546013,4.09820839 40.1480756,3.90117456 C40.1501626,3.89904911 40.1522686,3.89694235 40.1543933,3.89485454 Z" fill="#FFFFFF"></path>
                <path class="two" d="M20.1543933,3.89485454 L23.9763149,0.139296592 C24.1708311,-0.0518420739 24.4826329,-0.0518571125 24.6771675,0.139262789 L45.6916134,20.7848311 C46.0855801,21.1718824 46.0911863,21.8050225 45.704135,22.1989893 C45.7000188,22.2031791 45.6958657,22.2073326 45.6916762,22.2114492 L24.677098,42.8607841 C24.4825957,43.0519059 24.1708242,43.0519358 23.9762853,42.8608513 L20.1545186,39.1069479 C19.9575152,38.9134427 19.9546793,38.5968729 20.1481845,38.3998695 C20.1502893,38.3977268 20.1524132,38.395603 20.1545562,38.3934985 L36.9937789,21.8567812 C37.1908028,21.6632968 37.193672,21.3467273 37.0001876,21.1497035 C36.9980647,21.1475418 36.9959223,21.1453995 36.9937605,21.1432767 L20.1545208,4.60825197 C19.9574869,4.41477773 19.9546013,4.09820839 20.1480756,3.90117456 C20.1501626,3.89904911 20.1522686,3.89694235 20.1543933,3.89485454 Z" fill="#FFFFFF"></path>
                <path class="three" d="M0.154393339,3.89485454 L3.97631488,0.139296592 C4.17083111,-0.0518420739 4.48263286,-0.0518571125 4.67716753,0.139262789 L25.6916134,20.7848311 C26.0855801,21.1718824 26.0911863,21.8050225 25.704135,22.1989893 C25.7000188,22.2031791 25.6958657,22.2073326 25.6916762,22.2114492 L4.67709797,42.8607841 C4.48259567,43.0519059 4.17082418,43.0519358 3.97628526,42.8608513 L0.154518591,39.1069479 C-0.0424848215,38.9134427 -0.0453206733,38.5968729 0.148184538,38.3998695 C0.150289256,38.3977268 0.152413239,38.395603 0.154556228,38.3934985 L16.9937789,21.8567812 C17.1908028,21.6632968 17.193672,21.3467273 17.0001876,21.1497035 C16.9980647,21.1475418 16.9959223,21.1453995 16.9937605,21.1432767 L0.15452076,4.60825197 C-0.0425130651,4.41477773 -0.0453986756,4.09820839 0.148075568,3.90117456 C0.150162624,3.89904911 0.152268631,3.89694235 0.154393339,3.89485454 Z" fill="#FFFFFF"></path>
              </g>
            </svg>
          </span>
        </button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container section-heading section-heading--center">
      <p class="eyebrow">What happens next</p>
      <h2>What Happens Next</h2>
    </div>

    <div class="container process-grid process-grid--three">
      <article class="process-card">
        <span>01</span>
        <h3>Review</h3>
        <p>HEYA Talent Solutions reviews your vacancy and hiring requirements.</p>
      </article>
      <article class="process-card">
        <span>02</span>
        <h3>Recommend</h3>
        <p>You receive guidance on the best advertising package or recruitment support option.</p>
      </article>
      <article class="process-card">
        <span>03</span>
        <h3>Promote</h3>
        <p>Your vacancy can be prepared for visibility through listing and promotional channels.</p>
      </article>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container cta-band__inner">
      <h2>Not sure which advertising option fits your hiring needs?</h2>
      <a class="learn-more" href="/packages" aria-label="View packages">
        <span class="circle" aria-hidden="true">
          <span class="icon arrow"></span>
        </span>
        <span class="button-text">View Packages</span>
      </a>
    </div>
  </section>
</main>

<%- include("partials/footer") %>
