<%- include("partials/header", {
  active: "about",
  bodyId: "page-about",
  pageTitle: "About | HEYA Talent Solutions",
  pageDescription: "Learn about HEYA Talent Solutions, the workforce and recruitment division of HEYA Limited and Strategic Talent Acquisition Partner for Papua New Guinea."
}) %>

<main id="content">
  <section class="page-hero section--dark">
    <canvas id="aboutWireframeCanvas" class="wireframe-canvas" aria-hidden="true" hidden></canvas>
    <figure class="page-hero__cover" aria-hidden="true">
      <img src="/imgs/heya-talent-solutions-hero-logo-space-1600.jpg" alt="" loading="eager" decoding="async" />
    </figure>
    <div class="container page-hero__inner">
      <p class="eyebrow eyebrow--gold">About</p>
      <h1>HEYA Talent Solutions</h1>
      <p>A division of HEYA Limited, a Strategic Talent Acquisition Partner for Papua New Guinea.</p>
    </div>
  </section>

  <section class="section">
    <div class="container section-heading">
      <p class="eyebrow">Company Overview</p>
      <h2>Papua New Guinean-Owned. Workforce Focused.</h2>
    </div>
    <div class="container card-grid">
      <article class="card">
        <h3>HEYA Limited</h3>
        <p>A Papua New Guinean-owned company operating as a Strategic Talent Acquisition Partner, delivering professional recruitment, workforce, and talent solutions across Papua New Guinea.</p>
      </article>
      <article class="card">
        <h3>HEYA Talent Solutions</h3>
        <p>The workforce and recruitment division of HEYA Limited, established to support organizations with reliable, professional, and industry-focused human capital solutions.</p>
      </article>
      <article class="card">
        <h3>HEYA STAP</h3>
        <p>A strategic partner for businesses, government agencies, contractors, and project developers that need skilled personnel and practical workforce support.</p>
      </article>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container feature-band feature-band--light">
      <div>
        <p class="eyebrow">HEYA Talent Solutions</p>
        <h2>Built for PNG's High-Demand Workforce Sectors</h2>
        <p>With deep understanding of Papua New Guinea's labour market and industry requirements, HEYA Talent Solutions connects the right people with the right opportunities while helping organizations build productive, compliant, and sustainable workforces.</p>
      </div>
      <div class="about-sector-visual">
        <figure class="about-sector-visual__image">
          <img src="/imgs/coretalent-workforce.png" alt="HEYA Talent Solutions workforce advertising, screening, and mobilization sectors" loading="lazy" decoding="async" />
        </figure>
        <ul class="check-list check-list--large">
          <li>Skilled personnel and workforce planning</li>
          <li>Recruitment services and labour hire</li>
          <li>Onboarding and mobilization support</li>
          <li>Workforce management solutions</li>
          <li>Talent marketing and employer visibility</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container section-heading">
      <p class="eyebrow">Company Backing</p>
      <h2>Backed by HEYA Limited</h2>
      <p>HEYA Limited operates HEYA Talent Solutions as its focused recruitment and workforce solutions division, supporting talent acquisition strategy, recruitment operations, labour hire, workforce mobilization, and long-term client partnerships.</p>
    </div>
    <div class="container entity-strip">
      <div class="entity-strip__item">
        <span class="entity-strip__label">Parent Company</span>
        <h3 class="entity-strip__name">HEYA Limited</h3>
        <p class="entity-strip__desc">Registered Papua New Guinean company focused on delivering professional workforce solutions across PNG's key industry sectors.</p>
      </div>
      <div class="entity-strip__divider" aria-hidden="true"></div>
      <div class="entity-strip__item">
        <span class="entity-strip__label">Strategic Capability</span>
        <h3 class="entity-strip__name">HY STAP</h3>
        <p class="entity-strip__desc">Strategic talent acquisition capability focused on recruitment operations, workforce mobilization, labour hire, and long-term recruitment partnerships.</p>
      </div>
    </div>
  </section>

  <section class="section section--surface founder-section">
    <div class="container founder-block">
      <p class="eyebrow">Founder Story</p>
      <h2 class="founder-block__name">Founded by Hekeria Yako</h2>
      <p class="founder-block__bio">HEYA Limited was created to connect Papua New Guineans with real employment opportunities while supporting businesses with practical recruitment and workforce solutions.</p>
      <blockquote class="founder-block__quote">
        <span class="founder-block__quote-mark" aria-hidden="true">"</span>
        Built on 15 years of industry experience in end-to-end recruitment in mining across Papua New Guinea.
      </blockquote>
      <p class="founder-block__attribution">— Hekeria Yako, Founder &amp; Director, HEYA Limited</p>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container card-grid two-col">
      <article class="mission-card">
        <p class="eyebrow eyebrow--gold">Vision</p>
        <h2>PNG's leading Strategic Talent Acquisition Partner</h2>
        <p>To become Papua New Guinea's leading Strategic Talent Acquisition Partner, delivering innovative workforce solutions that empower businesses and transform careers.</p>
      </article>
      <article class="mission-card">
        <p class="eyebrow eyebrow--gold">Mission</p>
        <h2>Reliable, strategic workforce solutions</h2>
        <p>To provide professional, reliable, and tailored recruitment and workforce solutions that help organizations achieve operational excellence through quality talent acquisition and workforce management.</p>
      </article>
    </div>
  </section>

  <section class="section values-section">
    <div class="container values-head">
      <p class="eyebrow">Core Values</p>
      <h2>How We Work</h2>
    </div>
    <div class="container values-grid">
      <article class="value-item">
        <div class="value-item__icon"><i class="fa-solid fa-handshake-simple" aria-hidden="true"></i></div>
        <div class="value-item__num">01</div>
        <h3 class="value-item__title">Integrity</h3>
        <p class="value-item__desc">We operate with honesty, professionalism, and transparency in every engagement.</p>
      </article>
      <article class="value-item">
        <div class="value-item__icon"><i class="fa-solid fa-star" aria-hidden="true"></i></div>
        <div class="value-item__num">02</div>
        <h3 class="value-item__title">Excellence</h3>
        <p class="value-item__desc">We strive to deliver high-quality recruitment and workforce services that exceed client expectations.</p>
      </article>
      <article class="value-item">
        <div class="value-item__icon"><i class="fa-solid fa-people-group" aria-hidden="true"></i></div>
        <div class="value-item__num">03</div>
        <h3 class="value-item__title">Partnership</h3>
        <p class="value-item__desc">We build long-term relationships through collaboration, trust, and mutual success.</p>
      </article>
      <article class="value-item">
        <div class="value-item__icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></div>
        <div class="value-item__num">04</div>
        <h3 class="value-item__title">Reliability</h3>
        <p class="value-item__desc">We provide dependable workforce solutions that support business continuity and operational performance.</p>
      </article>
      <article class="value-item">
        <div class="value-item__icon"><i class="fa-solid fa-lightbulb" aria-hidden="true"></i></div>
        <div class="value-item__num">05</div>
        <h3 class="value-item__title">Innovation</h3>
        <p class="value-item__desc">We embrace modern recruitment strategies, technology, and workforce solutions to meet evolving industry demands.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Founder Track Record</p>
        <h2>Founder Track Record</h2>
      </div>
      <p class="section-lead">Hekeria Yako brings 15 years of industry experience in end-to-end recruitment in mining across Papua New Guinea. These points are founder career highlights, not unverified company achievements.</p>
    </div>
    <div class="container track-record-sheet">
      <article>
        <h3>15 Years of Industry Experience</h3>
        <p>Recruitment, workforce planning, and HR operations across major resource-sector and workforce-intensive environments.</p>
      </article>
      <article>
        <h3>Large-Scale Workforce Transition</h3>
        <p>Experience supporting major redundancy and workforce transition exercises with professionalism and structure.</p>
      </article>
      <article>
        <h3>Porgera Mine Restart Recruitment Campaign</h3>
        <p>Experience contributing to a major recruitment drive involving more than 2,500 employees within 6 months.</p>
      </article>
      <article>
        <h3>Recruitment Efficiency Improvement</h3>
        <p>Experience improving recruitment turnaround from long-cycle hiring toward faster, more practical hiring timelines.</p>
      </article>
      <article>
        <h3>Gender Diversity Leadership</h3>
        <p>Experience supporting workforce inclusion and improved female participation in mining workforce environments.</p>
      </article>
      <article>
        <h3>Strong PNG Industry Network</h3>
        <p>Connected across recruiters, HR professionals, employers, resource-sector stakeholders, private business, and government networks in Papua New Guinea.</p>
      </article>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container company-profile-band">
      <div class="company-profile-band__copy">
        <p class="eyebrow">Company Profile</p>
        <h2>Download Our Company Profile</h2>
        <p>Get the full picture — our services, capabilities, industry sectors, and approach to workforce solutions across Papua New Guinea.</p>
      </div>
      <a class="btn btn--gold company-profile-band__btn" href="/files/HEYA-TALENT-SOLUTIONS-PROFILE.docx" download="HEYA-Talent-Solutions-Company-Profile.docx">
        <i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i>
        Download Company Profile
      </a>
    </div>
  </section>

  <section class="section cta-band">
    <div class="container cta-band__inner">
      <h2>Connecting talent. Empowering business. Building the future.</h2>
      <div class="button-row button-row--center">
        <a class="btn btn--gold" href="/contact">Request Recruitment Support</a>
        <a class="btn btn--dark" href="/services">View Services</a>
      </div>
    </div>
  </section>
