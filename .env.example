# Local and script-friendly defaults.
NODE_ENV=development
HOST=0.0.0.0
PORT=9000

# Comma-separated extra origins for external integrations.
# Same-origin Render and custom-domain requests are detected automatically.
ALLOWED_ORIGINS=http://localhost:9000

# Use /var/data/website_data.sqlite on Render when the persistent disk is mounted.
SQLITE_DB_PATH=website_data.sqlite
# Optional Render disk helper. If SQLITE_DB_PATH is not set, the app stores
# website_data.sqlite inside this mounted path.
RENDER_DISK_MOUNT_PATH=/var/data
# Reserved for a future PostgreSQL adapter. The current app detects these URLs
# and keeps using SQLite until storage code is migrated off better-sqlite3.
DATABASE_URL=
POSTGRES_URL=

# Required in production for the private submissions dashboard.
SUBMISSIONS_TOKEN=change-this-admin-token
SESSION_SECRET=dummy-local-session-secret-change-me-1234567890
SESSION_COOKIE_NAME=heya_admin_session
SESSION_MAX_AGE_SECONDS=28800

# Required for secure careers dashboard authentication.
DASHBOARD_ADMIN_EMAIL=your-admin@yourdomain.com
DASHBOARD_ADMIN_PASSWORD=change-this-to-a-strong-password
DASHBOARD_PROFILE_IMAGE_URL=/imgs/heya-talent-solutions-mark.jpg?v=20260518
JWT_SECRET=change-this-to-a-long-random-secret
DASHBOARD_SESSION_DURATION=43200

# Optional private dashboard login slug.
# Set a stable value to keep the dashboard login URL static.
DASHBOARD_LOGIN_SLUG=login

# Pipedrive CRM integration.
# Set this on Render (Environment → Add variable). Never commit the real key.
# Find your token in Pipedrive → Profile → Personal Preferences → API.
PIPEDRIVE_API_KEY=replace-with-your-pipedrive-api-token

# Roxanne MCP dashboard integration.
# Accepts the variable names generated by Roxanne MCP registration
# (MCP_SECRET / MCP_GATEWAY_URL) OR the HEYA aliases (MCP_API_KEY / MCP_ENDPOINT).
MCP_GATEWAY_URL=https://roxannemcp.onrender.com
MCP_CLIENT_ID=replace-with-mcp-client-id
MCP_SECRET=replace-with-your-roxanne-mcp-secret
MCP_SCOPES=mcp:execute,mcp:agent,memory:read,memory:write,social:facebook,social:linkedin
MCP_ALLOWED_TOOLS=linkedin_post,facebook_post

# Facebook OAuth app credentials (forwarded to Roxanne MCP on OAuth start).
FACEBOOK_APP_ID=replace-with-facebook-app-id
FACEBOOK_CLIENT_SECRET=replace-with-facebook-client-secret

# Loading behavior:
# 1. Render/runtime environment variables win.
# 2. Then .env values load.
# 3. Then .env.local / .env.render / .env.render.local can override file-based defaults.

# Chatbot Configuration
# Defaults to /api/chat if not provided.
CHATBOT_API_URL=/api/chat
CHATBOT_MODEL=gpt-4.1-mini
CHATBOT_MAX_OUTPUT_TOKENS=300
OPENAI_API_KEY=replace-with-your-openai-api-key

# SendGrid Email Configuration
SENDGRID_ENABLED=true
SENDGRID_API_KEY=replace-with-your-sendgrid-api-key
BUSINESS_EMAIL=admin@heya.com.pg
EMAIL_FROM_NAME=HEYA Talent Solutions
EMAIL_INTERNAL_FROM_NAME=HEYA Talent Solutions Website
EMAIL_SUBJECT_PREFIX=HEYA Talent Solutions
SENDGRID_SANDBOX_MODE=false
BANNER_URL=http://cdn.mcauto-images-production.sendgrid.net/ddeb9514b26f02ed/15474cc9-c877-4815-a7e7-8f100d883f3e/1440x720.jpg

# Optional dedicated inboxes for careers workflows.
CAREERS_HR_EMAIL=hr@heya.com.pg
CAREERS_ADVERTISING_EMAIL=advertising@heya.com.pg

# Career upload handling
CAREERS_UPLOAD_DIR=data/uploads/careers
CAREERS_UPLOAD_MAX_MB=5
